<?xml version="1.0" encoding="utf-8"?>
<!-- favicon.svg's tile, full-bleed because the launcher masks it to its own shape. The
     gradients are placed as if the tile filled the 72 units a launcher shows. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:aapt="http://schemas.android.com/aapt"
        android:width="108dp"
        android:height="108dp"
        android:viewportWidth="108"
        android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                    android:type="linear"
                    android:startX="22.5" android:startY="18"
                    android:endX="85.5" android:endY="90">
                <item android:offset="0" android:color="#FF2E2E38"/>
                <item android:offset="0.5" android:color="#FF18181B"/>
                <item android:offset="1" android:color="#FF0A0A0F"/>
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                    android:type="radial"
                    android:centerX="87.75" android:centerY="92.25"
                    android:gradientRadius="63">
                <item android:offset="0" android:color="#47000000"/>
                <item android:offset="0.55" android:color="#1F000000"/>
                <item android:offset="1" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                    android:type="radial"
                    android:centerX="38.25" android:centerY="31.5"
                    android:gradientRadius="54">
                <item android:offset="0" android:color="#29FFFFFF"/>
                <item android:offset="0.45" android:color="#0FFFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
